      "label": "Relíquias: Forja e Materiais",
      "system": "tormenta20",
      "path": "packs/forja",
      "type": "Item",
      "ownership": { "PLAYER": "OBSERVER", "ASSISTANT": "OWNER" }
    },
    {
      "name": "bencaos",
      "label": "Relíquias: Bênçãos e Técnicas",
      "system": "tormenta20",
      "path": "packs/bencaos",
      "type": "Item",
      "ownership": { "PLAYER": "OBSERVER", "ASSISTANT": "OWNER" }
